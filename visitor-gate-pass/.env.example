# Application Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (Docker network defaults)
DB_URL=jdbc:mysql://db:3306/gatepass_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_PORT=3307

# Host Environment Settings
HOST_DB_URL=jdbc:mysql://localhost:3307/gatepass_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

# Jenkins & Docker CI/CD Configuration
JENKINS_PORT=8081
DOCKER_REGISTRY=docker.io/library
DOCKER_IMAGE=visitor-gate-pass
IMAGE_TAG=1.0.0
